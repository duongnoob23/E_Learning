@startuml Use Case Diagram - Quản Lý Khóa Học

!define RECTANGLE class

left to right direction

actor Admin as admin

rectangle "Module Quản Lý Khóa Học" {
  
  ' ========== USE CASE CHÍNH ==========
  
  usecase "Đăng nhập" as UC_Login
  usecase "Xem danh sách khóa học" as UC_ViewList {
    extension points:
    - Tạo mới khóa học
    - Xem chi tiết khóa học
    - Xóa khóa học
    - Lọc và tìm kiếm
  }
  
  usecase "Xem chi tiết khóa học\n(Preview)" as UC_ViewDetail {
    extension points:
    - Chỉnh sửa khóa học
    - Xây dựng khóa học
    - Duyệt/Từ chối khóa học
    - Xem Lesson
  }
  
  ' ========== QUẢN LÝ KHÓA HỌC ==========
  
  usecase "Tạo khóa học mới" as UC_CreateCourse {
    extension points:
    - Nhập thông tin cơ bản
    - Thêm video giới thiệu
    - Nhập thông tin bổ sung
    - Xây dựng khóa học
  }
  
  usecase "Cập nhật khóa học" as UC_UpdateCourse
  usecase "Xóa khóa học" as UC_DeleteCourse
  
  ' ========== XÂY DỰNG KHÓA HỌC ==========
  
  usecase "Xây dựng khóa học\n(Build Course)" as UC_BuildCourse {
    extension points:
    - Quản lý Module
    - Quản lý Lesson
  }
  
  usecase "Quản lý Module" as UC_ManageModule {
    extension points:
    - Thêm Module
    - Cập nhật Module
    - Xóa Module
    - Quản lý Lesson
  }
  
  usecase "Thêm Module" as UC_AddModule
  usecase "Cập nhật Module" as UC_UpdateModule
  usecase "Xóa Module" as UC_DeleteModule
  
  ' ========== QUẢN LÝ LESSON ==========
  
  usecase "Quản lý Lesson" as UC_ManageLesson {
    extension points:
    - Thêm Lesson
    - Cập nhật Lesson
    - Xóa Lesson
    - Xem trước Lesson
  }
  
  usecase "Thêm Lesson" as UC_AddLesson {
    extension points:
    - Chọn loại Lesson
    - Nhập thông tin Lesson
    - Xem trước Lesson
    - Lưu Lesson
  }
  
  usecase "Cập nhật Lesson" as UC_UpdateLesson
  usecase "Xóa Lesson" as UC_DeleteLesson
  usecase "Xem Lesson" as UC_ViewLesson
  usecase "Xem trước Lesson" as UC_PreviewLesson
  
  ' ========== CHI TIẾT TẠO KHÓA HỌC ==========
  
  usecase "Nhập thông tin cơ bản" as UC_EnterBasicInfo
  usecase "Thêm video giới thiệu" as UC_AddIntroVideo
  usecase "Nhập thông tin bổ sung" as UC_EnterSupplementaryInfo
  usecase "Chọn loại Lesson" as UC_SelectLessonType
  usecase "Nhập thông tin Lesson" as UC_EnterLessonInfo
  usecase "Lưu Lesson" as UC_SaveLesson
  
  ' ========== DUYỆT KHÓA HỌC ==========
  
  usecase "Duyệt khóa học" as UC_ApproveCourse
  usecase "Từ chối khóa học" as UC_RejectCourse
  
  ' ========== TÌM KIẾM VÀ LỌC ==========
  
  usecase "Lọc và tìm kiếm" as UC_FilterSearch
}

' ========== RELATIONSHIPS ==========

' Admin associations
admin --> UC_Login
admin --> UC_ViewList

' Include relationships (bắt buộc)
UC_Login ..> UC_ViewList : <<include>>\n(Sau khi đăng nhập\nluôn xem danh sách)

UC_CreateCourse ..> UC_EnterBasicInfo : <<include>>\n(Bắt buộc nhập\nthông tin cơ bản)

UC_BuildCourse ..> UC_ManageModule : <<include>>\n(Phải có ít nhất\n1 Module)

UC_ManageModule ..> UC_AddModule : <<include>>\n(Phải thêm Module\nđể xây dựng)

UC_ManageLesson ..> UC_AddLesson : <<include>>\n(Phải thêm Lesson\nvào Module)

UC_AddLesson ..> UC_SelectLessonType : <<include>>\n(Phải chọn loại\nLesson)

UC_AddLesson ..> UC_EnterLessonInfo : <<include>>\n(Phải nhập thông tin\nLesson)

UC_AddLesson ..> UC_SaveLesson : <<include>>\n(Phải lưu Lesson)

' Extend relationships (tùy chọn)
UC_CreateCourse ..> UC_ViewList : <<extend>>\n<Tạo mới khóa học>\n(Từ danh sách có thể\ntạo khóa học mới)

UC_ViewDetail ..> UC_ViewList : <<extend>>\n<Xem chi tiết khóa học>\n(Click vào khóa học\ntừ danh sách)

UC_DeleteCourse ..> UC_ViewList : <<extend>>\n<Xóa khóa học>\n(Xóa từ danh sách)

UC_FilterSearch ..> UC_ViewList : <<extend>>\n<Lọc và tìm kiếm>\n(Filter/Search trong\ndanh sách)

UC_UpdateCourse ..> UC_ViewDetail : <<extend>>\n<Chỉnh sửa khóa học>\n(Chỉnh sửa từ trang\nchi tiết)

UC_BuildCourse ..> UC_CreateCourse : <<extend>>\n<Xây dựng khóa học>\n(Xây dựng sau khi\ntạo khóa học)

UC_BuildCourse ..> UC_ViewDetail : <<extend>>\n<Xây dựng khóa học>\n(Xây dựng từ trang\nchi tiết)

UC_AddIntroVideo ..> UC_CreateCourse : <<extend>>\n<Thêm video giới thiệu>\n(Tùy chọn thêm video)

UC_EnterSupplementaryInfo ..> UC_CreateCourse : <<extend>>\n<Nhập thông tin bổ sung>\n(Tùy chọn thêm thông tin)

UC_ManageModule ..> UC_BuildCourse : <<extend>>\n<Quản lý Module>\n(Quản lý Module trong\nquá trình xây dựng)

UC_UpdateModule ..> UC_ManageModule : <<extend>>\n<Cập nhật Module>\n(Cập nhật Module đã có)

UC_DeleteModule ..> UC_ManageModule : <<extend>>\n<Xóa Module>\n(Xóa Module đã có)

UC_ManageLesson ..> UC_ManageModule : <<extend>>\n<Quản lý Lesson>\n(Quản lý Lesson trong\nModule)

UC_UpdateLesson ..> UC_ManageLesson : <<extend>>\n<Cập nhật Lesson>\n(Cập nhật Lesson đã có)

UC_DeleteLesson ..> UC_ManageLesson : <<extend>>\n<Xóa Lesson>\n(Xóa Lesson đã có)

UC_PreviewLesson ..> UC_AddLesson : <<extend>>\n<Xem trước Lesson>\n(Xem trước trước khi\nlưu)

UC_ViewLesson ..> UC_ViewDetail : <<extend>>\n<Xem Lesson>\n(Xem Lesson từ trang\nchi tiết)

UC_ApproveCourse ..> UC_ViewDetail : <<extend>>\n<Duyệt khóa học>\n(Duyệt từ trang\nchi tiết)

UC_RejectCourse ..> UC_ViewDetail : <<extend>>\n<Từ chối khóa học>\n(Từ chối từ trang\nchi tiết)

@enduml


























